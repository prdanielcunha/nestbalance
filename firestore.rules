rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(hid) { return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid); }
    function isMember(hid) { return signedIn() && exists(memberPath(hid)); }
    function role(hid) { return get(memberPath(hid)).data.role; }
    function canAdmin(hid) { return isMember(hid) && role(hid) in ['owner','admin']; }

    match /users/{uid}/householdRefs/{hid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(hid);
      allow update: if canAdmin(hid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isMember(hid) && role(hid) == 'owner';

      match /members/{uid} {
        allow read: if isMember(hid);
        allow create: if signedIn() && (
          canAdmin(hid) ||
          (uid == request.auth.uid && getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerUid == request.auth.uid && request.resource.data.role == 'owner')
        );
        allow update, delete: if canAdmin(hid) && uid != get(/databases/$(database)/documents/households/$(hid)).data.ownerUid;
      }

      match /accounts/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(hid);
        allow delete: if canAdmin(hid);
      }
      match /transactions/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(hid);
        allow delete: if canAdmin(hid);
      }
      match /commitments/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(hid);
        allow delete: if canAdmin(hid);
      }
      match /evidenceAssets/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.uploadedBy == request.auth.uid && request.resource.data.immutable == true;
        allow update, delete: if false;
        match /extractions/{extractionId} {
          allow read: if isMember(hid);
          allow create: if isMember(hid);
          allow update, delete: if false;
        }
      }
      match /auditEvents/{id} {
        allow read: if canAdmin(hid);
        allow create: if isMember(hid) && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
