rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NestBalance browser architecture is Auth-only.
    // All financial/household access is mediated by the authenticated backend.
    match /users/{uid}/householdRefs/{hid} {
      allow read, write: if false;
    }

    match /households/{hid} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
